# ==========================================================================
#  انسخ هذا الملف إلى .env.local واملأ القيم. لا ترفع .env.local إلى Git.
#    cp .env.local.example .env.local
# ==========================================================================

# --------------------------------------------------------------------------
#  Meta Pixel (فيسبوك / إنستجرام) — لتتبع الزوار والتحويلات
#  تجيب الـ Pixel ID من: Meta Events Manager > Data Sources > اختر البيكسل
# --------------------------------------------------------------------------
NEXT_PUBLIC_META_PIXEL_ID=

# --------------------------------------------------------------------------
#  الشات المساعد المجاني — حط مفتاح واحد بس من اللي تحت.
# --------------------------------------------------------------------------

#  1) Groq  ✅ المُوصى به — مجاني وسريع وبيشتغل عالميًا (بما فيها مصر)
#     المفتاح المجاني من: https://console.groq.com/keys
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

#  2) Google Gemini (بديل) — ⚠️ طبقته المجانية مش متاحة في كل الدول
#     المفتاح من: https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash

# --------------------------------------------------------------------------
#  Paymob — بوابة الدفع (كارت + محفظة موبايل)
#  كل القيم من لوحة تحكم Paymob:  https://accept.paymob.com/portal2/
# --------------------------------------------------------------------------
# 1) API Key:  Settings > Account Info > API Key
PAYMOB_API_KEY=

# 2) Integration IDs:  Developers > Payment Integrations
#    - رقم تكامل الكارت (Card / Online Card)
PAYMOB_CARD_INTEGRATION_ID=
#    - رقم تكامل محفظة الموبايل (Mobile Wallet)
PAYMOB_WALLET_INTEGRATION_ID=

# 3) iFrame ID (للدفع بالكارت):  Developers > iFrames
PAYMOB_IFRAME_ID=

# 4) HMAC Secret (للتحقق من صحة الـ webhook):  Settings > Account Info > HMAC
PAYMOB_HMAC_SECRET=

# --------------------------------------------------------------------------
#  إعدادات المتجر / المنتج
# --------------------------------------------------------------------------
# السعر الحالي بالجنيه (يُحوَّل داخليًا للقروش: 49 => 4900)
NEXT_PUBLIC_PRICE_EGP=49
NEXT_PUBLIC_ORIGINAL_PRICE_EGP=99

# الرابط الأساسي للموقع (بدون / في الآخر) — مطلوب لصفحة النجاح والـ callbacks
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# رابط زر التحميل بعد الدفع (سيبه زي ما هو — بيعدّي على /api/download المحمي بتوكن).
BOOK_DOWNLOAD_URL=/api/download

# رابط ملف الكتاب المباشر — مطلوب على Vercel (السيرفرليس حده 4.5 ميجا، والكتاب أكبر).
# ارفع book/book.pdf على Vercel Blob أو Dropbox (?dl=1) وحط الرابط هنا.
# محليًا سيبه فاضي، وهيتقدّم الملف من book/book.pdf مباشرة.
BOOK_FILE_URL=

# --------------------------------------------------------------------------
#  الكوبونات + حماية التحميل
# --------------------------------------------------------------------------
# باسورد صفحة الأدمن /admin (عشان تعمل كوبونات). حط باسورد قوي.
ADMIN_PASSWORD=
# سر توقيع روابط التحميل. حط نص عشوائي طويل (32 حرف أو أكتر).
DOWNLOAD_TOKEN_SECRET=

# --------------------------------------------------------------------------
#  تخزين الكوبونات على Vercel (مطلوب للنشر — نظام ملفات Vercel مؤقت)
#  اعمل Redis مجاني من Upstash (أو تكامل Vercel KV) وحط القيمتين دول:
#  https://upstash.com  →  Create Database  →  REST API
# --------------------------------------------------------------------------
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# --------------------------------------------------------------------------
#  الدفع عبر InstaPay (الطريقة الحالية)
# --------------------------------------------------------------------------
NEXT_PUBLIC_INSTAPAY_IPA=omarkhaled5758@instapay
# رابط التحويل المباشر (اختياري)
NEXT_PUBLIC_INSTAPAY_LINK=https://ipn.eg/S/omarkhaled5758/instapay/8lrKcC
# رقم واتساب بالصيغة الدولية بدون + (اختياري) — احتياطي لو الرفع فشل. مثال: 201012345678
NEXT_PUBLIC_WHATSAPP_NUMBER=201551454730

# --- بيانات التواصل / التعريف بيك (بتظهر في قسم "مين اللي بيبيعلك؟"، الفاضي بيتخفي) ---
NEXT_PUBLIC_AUTHOR_BIO=
NEXT_PUBLIC_INSTAGRAM_URL=
NEXT_PUBLIC_FACEBOOK_URL=
NEXT_PUBLIC_CONTACT_EMAIL=omarkhaled12oki@gmail.com
NEXT_PUBLIC_CONTACT_PHONE=+201551454730
